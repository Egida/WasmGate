# Normalize line endings in the repository (LF in history, native in worktree).
* text=auto

# Go source & config: LF (Go convention).
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
Makefile text eol=lf
LICENSE  text eol=lf

# Windows scripts prefer CRLF.
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binaries (never diff/normalize).
*.exe   binary
*.wasm  binary
